# Copy thành .env rồi điền giá trị thật
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=agent-office
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
# AI local (Ollama/LM Studio/vLLM, chuẩn OpenAI). LLM_PROVIDER=fake = trả lời giả, không gọi máy nào.
LLM_PROVIDER=local
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=qwen3:4b
HERMES_URL=
HERMES_API_KEY=
HERMES_MODEL_CHECK_URL=
# hermes_admin.py trên máy Hermes (quản lý bot/profile); key trùng HERMES_ADMIN_KEY bên máy Hermes
HERMES_ADMIN_URL=
HERMES_ADMIN_KEY=
# Bot mẫu để sao chép khi tạo agent mới (trống = tạo bot trống)
HERMES_CLONE_FROM=
# none = tắt suy luận cho model thinking (qwen3.x); trống nếu server không hỗ trợ
LOCAL_LLM_REASONING_EFFORT=none
# OmniRoute (docker compose). Sinh khóa: openssl rand -base64 48 (JWT) và openssl rand -hex 32 (API_KEY_SECRET)
OMNIROUTE_JWT_SECRET=
OMNIROUTE_API_KEY_SECRET=
OMNIROUTE_INITIAL_PASSWORD=
OMNIROUTE_PORT=20128
