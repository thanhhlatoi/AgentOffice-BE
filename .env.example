# Copy thành .env rồi điền giá trị thật
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=agent-office
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
# AI local (Ollama/LM Studio/vLLM, chuẩn OpenAI). LLM_PROVIDER=fake = trả lời giả, không gọi máy nào.
LLM_PROVIDER=local
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=qwen3:4b
HERMES_URL=
HERMES_API_KEY=
HERMES_MODEL_CHECK_URL=
# LLM gateway 9Router: đặt LLM_PROVIDER=openai-compatible (thay cho fake/local ở trên). Cùng cổng 20128 với OmniRoute: chỉ chạy một trong hai
NINEROUTER_URL=http://localhost:20128
NINEROUTER_API_KEY=
# mật khẩu dashboard 9Router (docker compose --profile gateway)
INITIAL_PASSWORD=
# hermes_admin.py trên máy Hermes (quản lý bot/profile); key trùng HERMES_ADMIN_KEY bên máy Hermes
HERMES_ADMIN_URL=
HERMES_ADMIN_KEY=
# Bot mẫu để sao chép khi tạo agent mới (trống = tạo bot trống). Nên dùng một bot mẫu riêng, sạch (vd tpl_base): không dùng bot đang chạy việc thật
# vì mọi bot mới thừa hưởng cấu hình/skill của nó. BE ghi đè description, SOUL và model theo từng agent; plugin KHÔNG do BE quản lý, tự cấu hình trên máy Hermes.
HERMES_CLONE_FROM=
# none = tắt suy luận cho model thinking (qwen3.x); trống nếu server không hỗ trợ
LOCAL_LLM_REASONING_EFFORT=none
# OmniRoute (docker compose). Sinh khóa: openssl rand -base64 48 (JWT) và openssl rand -hex 32 (API_KEY_SECRET)
OMNIROUTE_JWT_SECRET=
OMNIROUTE_API_KEY_SECRET=
OMNIROUTE_INITIAL_PASSWORD=
OMNIROUTE_PORT=20128
# Sửa Cài đặt AI từ giao diện: OWNER_TOKEN (>=16 ký tự, tạo bằng: openssl rand -hex 32) và AGENTOFFICE_MASTER_KEY (openssl rand -base64 32)
OWNER_TOKEN=
AGENTOFFICE_MASTER_KEY=
# Tên máy ngoài mạng nội bộ được phép làm địa chỉ AI/Hermes (phân cách bằng dấu phẩy). Trống = chỉ LAN, Tailscale, localhost
AI_ALLOWED_HOSTS=
# Khoa API cua BE (>=16 ky tu, sinh bang: openssl rand -hex 32). Trong = tu choi moi request. FE dat VITE_API_KEY trung gia tri nay
AGENTOFFICE_API_KEY=
# fake | hermes: hermes = task chay that bang bot cua agent (can HERMES_ADMIN_URL/KEY)
AGENT_RUNNER=fake
